
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Titan Slayer 3D</title>
<style>
*{box-sizing:border-box}
body{margin:0;overflow:hidden;background:#101923;color:white;font-family:Arial}
canvas{display:block}
#hud{
 position:fixed;top:20px;left:20px;width:230px;
 background:#101923c9;padding:18px;border:1px solid #ffffff44;
 border-radius:12px;z-index:2;backdrop-filter:blur(12px)
}
h2{margin:0;letter-spacing:3px}
.small{font-size:10px;color:#aabccc;letter-spacing:3px;margin:5px 0 15px}
.label{font-size:11px;color:#bdcbd7;margin:12px 0 5px}
.bar{height:9px;background:#35414b;border-radius:10px;overflow:hidden}
.fill{height:100%;width:100%;transition:width .15s}
#health{background:#53e58a}
#gas{background:#53cfff}
#score{font-size:22px;font-weight:bold}
#stats{
 position:fixed;right:20px;top:20px;
 background:#101923c9;padding:15px 20px;
 border:1px solid #ffffff44;border-radius:10px;
 text-align:right;z-index:2
}
#controls{
 position:fixed;bottom:18px;left:50%;transform:translateX(-50%);
 background:#101923cc;padding:12px 20px;
 border:1px solid #ffffff44;border-radius:10px;
 font-size:11px;white-space:nowrap;z-index:2
}
kbd{background:#35475b;padding:4px 7px;border-radius:4px}
#menu{
 position:fixed;inset:0;z-index:5;
 display:flex;align-items:center;justify-content:center;
 background:linear-gradient(130deg,#101b2aee,#253a49bb);
 text-align:center
}
.panel{
 width:min(90%,480px);padding:38px;
 background:#101c2bee;border:1px solid #a8c5d366;
 border-radius:17px;box-shadow:0 20px 80px #000b
}
h1{font-size:47px;letter-spacing:4px;margin:15px 0}
p{color:#b7c7d4;line-height:1.8}
button{
 background:linear-gradient(120deg,#d85d40,#9e302c);
 color:white;border:0;padding:15px 35px;
 border-radius:7px;font-size:16px;font-weight:bold;
 letter-spacing:2px;cursor:pointer
}
button:hover{filter:brightness(1.25)}
#crosshair{
 position:fixed;left:50%;top:50%;
 transform:translate(-50%,-50%);
 color:white;opacity:.7;pointer-events:none;z-index:2
}
#notice{
 position:fixed;top:43%;width:100%;
 text-align:center;font-size:30px;font-weight:bold;
 letter-spacing:5px;pointer-events:none;
 text-shadow:0 4px 20px black
}
</style>
</head>
<body>

<div id="hud">
 <h2>TITAN SLAYER</h2>
 <div class="small">SCOUT REGIMENT • 3D</div>
 <div class="label">HEALTH</div>
 <div class="bar"><div id="health" class="fill"></div></div>
 <div class="label">ODM GAS</div>
 <div class="bar"><div id="gas" class="fill"></div></div>
 <div class="label">SCORE</div>
 <div id="score">000000</div>
</div>

<div id="stats">
 <div style="font-size:10px;color:#aabccc">TITANS DEFEATED</div>
 <b id="kills" style="font-size:25px">0</b>
</div>

<div id="crosshair">+</div>
<div id="notice"></div>

<div id="controls">
 <kbd>WASD</kbd> MOVE
 <kbd>SPACE</kbd> JUMP
 <kbd>SHIFT</kbd> BOOST
 <kbd>J</kbd> ATTACK
 <kbd>K</kbd> SPECIAL
 <kbd>MOUSE</kbd> LOOK
</div>

<div id="menu">
 <div class="panel">
  <div style="letter-spacing:5px;color:#8ec9df">HUMANITY'S LAST DEFENSE</div>
  <h1 id="title">TITAN<br>SLAYER</h1>
  <p id="description">
   The Titans have breached the outer district.
   Take your blades and defend the city.
  </p>
  <p>WASD: Move • Mouse: Look<br>
  Space: Jump • Shift: Boost<br>
  J: Attack • K: Special</p>
  <button onclick="startGame()">START MISSION</button>
 </div>
</div>

<script type="importmap">
{
 "imports":{
  "three":"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js"
 }
}
</script>

<script type="module">
import * as THREE from "three";

const scene=new THREE.Scene();
scene.background=new THREE.Color(0x9db4c2);
scene.fog=new THREE.FogExp2(0x9db4c2,.007);

const camera=new THREE.PerspectiveCamera(
 70,innerWidth/innerHeight,.1,1500
);

const renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;
renderer.toneMapping=THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure=1.15;
document.body.appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0xc8e4ff,0x594638,2));

const sun=new THREE.DirectionalLight(0xffe0b0,3);
sun.position.set(-100,150,80);
sun.castShadow=true;
sun.shadow.mapSize.set(2048,2048);
sun.shadow.camera.left=-180;
sun.shadow.camera.right=180;
sun.shadow.camera.top=180;
sun.shadow.camera.bottom=-180;
scene.add(sun);

const mat=(color,roughness=.85)=>new THREE.MeshStandardMaterial({
 color,roughness
});

const grass=mat(0x455b42);
const stone=mat(0x7c7b70);
const roof=mat(0x374653);
const skin=mat(0xb77e69);
const uniform=mat(0x9da997);
const pants=mat(0x394a5b);
const metal=mat(0xc6d8df,.3);
const dark=mat(0x292b30);

function box(parent,x,y,z,w,h,d,material){
 const o=new THREE.Mesh(
  new THREE.BoxGeometry(w,h,d),material
 );
 o.position.set(x,y,z);
 o.castShadow=true;
 o.receiveShadow=true;
 parent.add(o);
 return o;
}

function sphere(parent,x,y,z,sx,sy,sz,material){
 const o=new THREE.Mesh(
  new THREE.SphereGeometry(1,16,12),material
 );
 o.position.set(x,y,z);
 o.scale.set(sx,sy,sz);
 o.castShadow=true;
 parent.add(o);
 return o;
}

// Ground
const floor=new THREE.Mesh(
 new THREE.PlaneGeometry(1500,1500),grass
);
floor.rotation.x=-Math.PI/2;
floor.receiveShadow=true;
scene.add(floor);

// City
for(let x=-300;x<=300;x+=45){
 for(let z=-300;z<=300;z+=55){
  if(Math.random()<.18)continue;
  let w=25+Math.random()*12;
  let h=18+Math.random()*45;
  const b=new THREE.Group();
  b.position.set(x,0,z);
  scene.add(b);

  box(b,0,h/2,0,w,h,35,
   new THREE.MeshStandardMaterial({
    color:new THREE.Color().setHSL(.55,.12,.25+Math.random()*.13),
    roughness:.9
   })
  );

  // Roof
  const r=new THREE.Mesh(
   new THREE.ConeGeometry(w*.8,9,4),roof
  );
  r.position.y=h+4;
  r.rotation.y=Math.PI/4;
  r.castShadow=true;
  b.add(r);

  // Windows
  for(let yy=5;yy<h-5;yy+=9){
   for(let xx=-w/2+5;xx<w/2-3;xx+=10){
    box(b,xx,yy,17.6,.9,3,.3,mat(0xc9b58c,.5));
   }
  }
 }
}

// Walls in distance
for(let z=-330;z<=330;z+=45){
 box(scene,-360,24,z,15,48,45,stone);
 box(scene,360,24,z,15,48,45,stone);
}

// Clouds
const clouds=[];
for(let i=0;i<30;i++){
 const g=new THREE.Group();
 for(let j=0;j<5;j++){
  sphere(g,j*8,Math.random()*3,Math.random()*3,
   8+Math.random()*5,3+Math.random()*3,5,
   new THREE.MeshBasicMaterial({color:0xffffff,transparent:true,opacity:.28})
  );
 }
 g.position.set(
  Math.random()*900-450,
  75+Math.random()*65,
  Math.random()*900-450
 );
 scene.add(g);clouds.push(g);
}

// Player
const player=new THREE.Group();
scene.add(player);

const torso=box(player,0,2.6,0,1.15,1.6,.65,uniform);
box(player,0,2.8,.34,.8,1.2,.1,mat(0xe0d9c4));
box(player,0,1.8,0,1.35,.18,.8,dark);

// Legs
const legs=[];
for(let s of [-1,1]){
 const leg=box(player,s*.35,.9,0,.42,1.4,.5,pants);
 legs.push(leg);
 box(player,s*.35,.18,.12,.48,.3,.8,dark);

 // Shoulder and arm
 sphere(player,s*.78,3.1,0,.4,.4,.4,uniform);
 const arm=box(player,s*.82,2.3,0,.35,1.2,.4,uniform);
 arm.rotation.z=s*.12;

 // ODM equipment
 box(player,s*.72,1.8,-.4,.35,.65,.35,metal);
}

// Head and hair
sphere(player,0,3.85,0,.39,.48,.38,skin);
sphere(player,0,4.1,-.02,.4,.24,.4,dark);

// Cape
const cape=box(player,0,2.7,-.48,1.5,1.7,.12,mat(0x526d56));
cape.rotation.x=-.15;

// Swords
const swords=[];
for(let s of [-1,1]){
 const sword=box(player,s*.9,2.25,.4,.1,1.5,.1,metal);
 sword.rotation.z=s*.45;
 swords.push(sword);
}

// ODM cable visuals
const cableMat=new THREE.LineBasicMaterial({color:0xb9d7df});
const cables=[];
for(let i=0;i<2;i++){
 const geo=new THREE.BufferGeometry().setFromPoints([
  new THREE.Vector3(0,0,0),new THREE.Vector3(0,0,0)
 ]);
 const line=new THREE.Line(geo,cableMat);
 scene.add(line);cables.push(line);
}

// Titan creation
let titans=[];

function createTitan(x,z,size=1){
 const t=new THREE.Group();
 t.position.set(x,0,z);
 t.scale.setScalar(size);
 scene.add(t);

 const body=sphere(t,0,4.8,0,1.35,2.6,.85,skin);
 sphere(t,0,8,0,.85,1.05,.8,skin);

 // Face
 sphere(t,-.34,8.15,.68,.13,.12,.07,dark);
 sphere(t,.34,8.15,.68,.13,.12,.07,dark);

 // Mouth
 box(t,0,7.65,.78,.45,.09,.05,dark);

 // Arms
 for(let s of [-1,1]){
  const arm=box(t,s*1.65,4.7,0,.65,3,.65,skin);
  arm.rotation.z=s*.13;
  sphere(t,s*1.65,3.05,0,.43,.48,.43,skin);

  const leg=box(t,s*.65,1.4,0,.75,2.8,.75,skin);
  box(t,s*.65,.15,.25,.8,.3,1,dark);
 }

 const health=box(t,0,9.6,0,2.2,.12,.1,mat(0x41e47d));
 const aura=sphere(t,0,4.5,0,1.7,3,.9,
  new THREE.MeshBasicMaterial({
   color:0xffbd9b,transparent:true,opacity:.08
  })
 );
 return {
  group:t,health,aura,hp:100,
  size,speed:2+Math.random()*1.2,
  hit:0,active:true
 };
}

function addTitan(){
 const x=player.position.x+Math.random()*45+45;
 const z=(Math.random()-.5)*70;
 titans.push(createTitan(x,z,Math.random()>.7?1.4:1));
}

for(let i=0;i<7;i++){
 titans.push(createTitan(50+i*28,(Math.random()-.5)*100,
  Math.random()>.7?1.35:1));
}

// State
let health=100,gas=100,score=0,kills=0;
let velocity=new THREE.Vector3();
let keys={};
let yaw=0,pitch=.15;
let grounded=true,attackTime=0,specialTime=0;
let invincible=0;
let running=false,mouseLocked=false;
let particles=[];
let last=performance.now();

document.addEventListener("keydown",e=>{
 keys[e.key.toLowerCase()]=true;
 if(e.key.toLowerCase()==="r")startGame();
 if(e.key.toLowerCase()==="j")attack();
 if(e.key.toLowerCase()==="k")special();
 if(e.code==="Space")e.preventDefault();
});
document.addEventListener("keyup",e=>{
 keys[e.key.toLowerCase()]=false;
});

renderer.domElement.addEventListener("click",()=>{
 if(running)renderer.domElement.requestPointerLock();
});

document.addEventListener("pointerlockchange",()=>{
 mouseLocked=document.pointerLockElement===renderer.domElement;
});

document.addEventListener("mousemove",e=>{
 if(mouseLocked){
  yaw-=e.movementX*.0025;
  pitch=Math.max(-.5,Math.min(.6,pitch-e.movementY*.002));
 }
});

function particleBurst(position,color=0xffd8a5,count=15){
 for(let i=0;i<count;i++){
  const m=new THREE.Mesh(
   new THREE.SphereGeometry(.09,6,6),
   new THREE.MeshBasicMaterial({color})
  );
  m.position.copy(position);
  scene.add(m);
  particles.push({
   mesh:m,
   v:new THREE.Vector3(
    (Math.random()-.5)*10,
    Math.random()*9,
    (Math.random()-.5)*10
   ),
   life:.7+Math.random()*.5
  });
 }
}

function attack(){
 if(!running||attackTime>0)return;
 attackTime=.4;
 player.rotation.y=yaw;
 let hit=false;
 for(const t of titans){
  if(!t.active)continue;
  const d=t.group.position.distanceTo(player.position);
  if(d<13){
   t.hp-=40;
   t.hit=.25;
   hit=true;
   particleBurst(t.group.position.clone().add(
    new THREE.Vector3(0,7,0)
   ),0xffe4d0,20);
   if(t.hp<=0)defeat(t);
  }
 }
 if(hit)score+=25;
}

function special(){
 if(!running||specialTime>0||gas<30)return;
 gas-=30;specialTime=1;
 for(const t of titans){
  if(!t.active)continue;
  if(t.group.position.distanceTo(player.position)<24){
   t.hp-=70;
   particleBurst(t.group.position.clone().add(
    new THREE.Vector3(0,6,0)
   ),0x75dfff,30);
   if(t.hp<=0)defeat(t);
  }
 }
}

function defeat(t){
 if(!t.active)return;
 t.active=false;
 scene.remove(t.group);
 kills++;score+=200;
 particleBurst(t.group.position.clone().add(
  new THREE.Vector3(0,5,0)
 ),0xe9b59a,45);
 setTimeout(()=>{
  if(running){
   addTitan();
  }
 },1800);
}

function update(dt){
 if(!running)return;

 let forward=new THREE.Vector3(
  -Math.sin(yaw),0,-Math.cos(yaw)
 );
 let right=new THREE.Vector3(
  Math.cos(yaw),0,-Math.sin(yaw)
 );
 let move=new THREE.Vector3();

 if(keys.w)move.add(forward);
 if(keys.s)move.sub(forward);
 if(keys.d)move.add(right);
 if(keys.a)move.sub(right);
 if(move.length()>0)move.normalize();

 let boost=keys.shift&&gas>0;
 let speed=boost?28:11;

 if(boost){
  gas=Math.max(0,gas-25*dt);
  particleBurst(player.position.clone().add(
   new THREE.Vector3(0,1,0)
  ),0x9deaff,1);
 }else gas=Math.min(100,gas+8*dt);

 velocity.x=THREE.MathUtils.damp(
  velocity.x,move.x*speed,8,dt
 );
 velocity.z=THREE.MathUtils.damp(
  velocity.z,move.z*speed,8,dt
 );

 if(keys[" "]&&grounded){
  velocity.y=12;
  grounded=false;
 }

 velocity.y-=25*dt;
 player.position.x+=velocity.x*dt;
 player.position.z+=velocity.z*dt;
 player.position.y+=velocity.y*dt;

 if(player.position.y<0){
  player.position.y=0;velocity.y=0;grounded=true;
 }

 player.position.x=THREE.MathUtils.clamp(
  player.position.x,-330,330
 );
 player.position.z=THREE.MathUtils.clamp(
  player.position.z,-330,330
 );

 if(move.length()>.05&&!boost){
  player.rotation.y=THREE.MathUtils.lerp(
   player.rotation.y,Math.atan2(-move.x,-move.z),.12
  );
 }

 legs.forEach((leg,i)=>{
  leg.rotation.x=move.length()>.05?
   Math.sin(performance.now()*.012+i*Math.PI)*.5:0;
 });

 attackTime=Math.max(0,attackTime-dt);
 specialTime=Math.max(0,specialTime-dt);
 invincible=Math.max(0,invincible-dt);

 swords.forEach(s=>{
  s.rotation.x=attackTime>0?Math.sin(attackTime*20)*1.1:0;
 });

 for(const t of titans){
  if(!t.active)continue;
  const target=player.position.clone();
  target.y=0;
  const diff=target.sub(t.group.position);
  const dist=diff.length();

  if(dist>4){
   diff.normalize();
   t.group.position.addScaledVector(diff,t.speed*dt);
   t.group.rotation.y=Math.atan2(-diff.x,-diff.z);
  }

  t.group.position.y=Math.sin(performance.now()*.003)*.08;

  if(dist<5&&invincible<=0){
   health-=12*dt;
   if(health<=0)endGame();
  }

  t.health.scale.x=Math.max(0,t.hp/100);
 }

 for(const p of particles){
  p.mesh.position.addScaledVector(p.v,dt);
  p.v.y-=8*dt;p.life-=dt;
  p.mesh.material.opacity=Math.max(0,p.life);
  p.mesh.material.transparent=true;
 }
 particles=particles.filter(p=>{
  if(p.life<=0){
   scene.remove(p.mesh);return false;
  }
  return true;
 });

 cloudsMove(dt);

 document.getElementById("health").style.width=health+"%";
 document.getElementById("gas").style.width=gas+"%";
 document.getElementById("score").textContent=
  String(score).padStart(6,"0");
 document.getElementById("kills").textContent=kills;
}

function cloudsMove(dt){
 clouds.forEach(cloud=>{
  cloud.position.x+=dt*1.3;
  if(cloud.position.x>500)cloud.position.x=-500;
 });
}

function cameraUpdate(dt){
 const distance=13;
 const desired=new THREE.Vector3(
  player.position.x+Math.sin(yaw)*distance,
  player.position.y+6+pitch*7,
  player.position.z+Math.cos(yaw)*distance
 );
 camera.position.lerp(desired,1-Math.exp(-5*dt));
 const look=player.position.clone().add(
  new THREE.Vector3(0,3,0)
 );
 camera.lookAt(look);
}

function animate(time){
 requestAnimationFrame(animate);
 let dt=Math.min((time-last)/1000,.04);
 last=time;
 if(running){
  update(dt);
  cameraUpdate(dt);
 }
 renderer.render(scene,camera);
}
requestAnimationFrame(animate);

function startGame(){
 health=100;gas=100;score=0;kills=0;
 player.position.set(0,0,0);
 velocity.set(0,0,0);
 yaw=0;pitch=.15;
 for(const t of titans)scene.remove(t.group);
 titans=[];
 for(let i=0;i<7;i++){
  titans.push(createTitan(45+i*28,(Math.random()-.5)*100,
   Math.random()>.7?1.35:1));
 }
 particles.forEach(p=>scene.remove(p.mesh));
 particles=[];
 document.getElementById("menu").style.display="none";
 document.getElementById("notice").textContent="DEFEND THE CITY";
 setTimeout(()=>{
  document.getElementById("notice").textContent="";
 },1800);
 running=true;
}

function endGame(){
 running=false;
 if(document.pointerLockElement)document.exitPointerLock();
 document.getElementById("menu").style.display="flex";
 document.getElementById("title").innerHTML="MISSION<br>FAILED";
 document.getElementById("description").innerHTML=
 "Score: "+score+"<br>Titans defeated: "+kills+
 "<br>Try again, Scout.";
 document.querySelector("button").textContent="RESTART";
}

addEventListener("resize",()=>{
 camera.aspect=innerWidth/innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});

</script>
</body>
</html>
